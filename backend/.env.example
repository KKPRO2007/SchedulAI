DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PORT=5000
AUTH_SECRET=change-me

# AI assistant (optional). Groq is tried first, Gemini is the fallback.
# Without either key the assistant still answers with built-in timetable lookups.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
